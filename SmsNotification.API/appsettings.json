{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PostgresDb": {
      "Host": "YOUR_DB_HOST",
      "Port": "5432",
      "Database": "YOUR_DATABASE",
      "Username": "YOUR_DB_USERNAME",
      "Password": "YOUR_DB_PASSWORD"
    }
  },

  "SmsGateway": {
    "BaseUrl": "https://your-sms-provider-api.com/send",
    "UserName": "YOUR_SMS_USERNAME",
    "Pin": "YOUR_SMS_PIN",
    "SenderId": "YOUR_SENDER_ID",
    "EntityId": "YOUR_ENTITY_ID",
    "TimeoutSeconds": 30
  },

  "NotificationGateway": {
    "BaseUrl": "http://localhost:Portno/send",
    "Priority": "high-volatile",
    "TimeoutSeconds": 30
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",

    "ExchangeName": "otp_exchange",

    "SmsQueue": "sms_queue",
    "SmsRoutingKey": "sms",
    "SmsDlq": "sms_queue.dlq",

    "NotificationQueue": "notification_queue",
    "NotificationRoutingKey": "notification",
    "NotificationDlq": "notification_queue.dlq"
  },

  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}